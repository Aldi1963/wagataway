# ─────────────────────────────────────────────────────────────────────────
# WaGataway — Production env untuk VPS
# Copy jadi deploy/.env lalu isi semua nilai. JANGAN commit file .env asli.
#   cp deploy/.env.production.example deploy/.env
# ─────────────────────────────────────────────────────────────────────────

# Domain & HTTPS (untuk Caddy)
DOMAIN=app.contohdomain.com
TLS_EMAIL=admin@contohdomain.com

# App
APP_NAME=WaGataway
APP_URL=https://app.contohdomain.com

# Database (dipakai oleh container postgres + app)
POSTGRES_DB=wagataway
POSTGRES_USER=wagataway
# Ganti dengan password kuat — generate: openssl rand -base64 24
POSTGRES_PASSWORD=GANTI_PASSWORD_KUAT

# JWT — WAJIB diganti. Generate: openssl rand -hex 32
JWT_SECRET=GANTI_DENGAN_SECRET_ACAK_PANJANG
JWT_EXPIRY=24h

# Email (SMTP) — opsional
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=WaGataway <noreply@contohdomain.com>

# AI — opsional (isi jika pakai fitur AI CS Bot)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Payment Gateway — opsional
PAYMENT_GATEWAY_KEY=
PAYMENT_GATEWAY_SECRET=

# Telegram Notifications — opsional
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
